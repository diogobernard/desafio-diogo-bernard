### Emitir nota para pessoa física (202)
POST http://localhost:8080/issuance-requests
Content-Type: application/json
X-Client-Id: cliente-local
Idempotency-Key: 3f6c2a1e-8b4d-4c7a-9e21-5d0b7f9a1c01

{
  "recipient": { "person_type": "FISICA", "document": "52998224725" },
  "items": [
    { "code": "SKU-001", "description": "Teclado", "unit_price": 250.00, "quantity": 2 },
    { "code": "SKU-002", "description": "Mouse", "unit_price": 99.90, "quantity": 1 }
  ],
  "freight_value": 30.00,
  "addresses": [{ "purpose": "ENTREGA", "region": "SUDESTE" }]
}

### Emitir nota para pessoa jurídica (202)
POST http://localhost:8080/issuance-requests
Content-Type: application/json
X-Client-Id: cliente-local
Idempotency-Key: 3f6c2a1e-8b4d-4c7a-9e21-5d0b7f9a1c02

{
  "recipient": { "person_type": "JURIDICA", "document": "11222333000181", "tax_regime": "LUCRO_PRESUMIDO" },
  "items": [{ "code": "SKU-100", "description": "Monitor", "unit_price": 1500.00, "quantity": 1 }],
  "freight_value": 50.00,
  "addresses": [
    { "purpose": "COBRANCA", "region": "SUL" },
    { "purpose": "ENTREGA", "region": "NORDESTE" }
  ]
}

